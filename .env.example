# Copy to .env.local and use the Firebase Console web app configuration.
# These are public client identifiers. Never add admin keys or passwords here.
EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_AUTH_DOMAIN
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_STORAGE_BUCKET
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_MESSAGING_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_APP_ID
